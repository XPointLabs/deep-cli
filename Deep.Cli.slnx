    <Project Path="../deep-protocol/src/Deep.Protocol.ProfileCarrier/Deep.Protocol.ProfileCarrier.csproj" />
  </Folder>
  <Project Path="src/Deep.Cli/Deep.Cli.csproj" />
  <Project Path="tests/Deep.Cli.Tests/Deep.Cli.Tests.csproj" />
</Solution>
